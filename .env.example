# --- Google Calendar (OAuth, single user) ---
# Create an OAuth "Desktop app" credential in Google Cloud Console and paste here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled in automatically the first time you run `npm run auth`.
GOOGLE_REFRESH_TOKEN=
# Which calendar to read. "primary" is your main calendar.
GOOGLE_CALENDAR_ID=primary

# --- Slack ---
# A *user* token (starts with xoxp-) with the users.profile:write scope.
# Bot tokens cannot set your personal status.
SLACK_USER_TOKEN=

# --- AeroDataBox (RapidAPI) for airport codes + live flight status ---
# Optional. Without it, the OOO message falls back to calendar-only data.
RAPIDAPI_KEY=

# --- Behavior (optional) ---
# How many hours before departure to show the "departs in Xh Xm" pre-flight status.
PREFLIGHT_HOURS=3
# How many minutes after arrival to keep the "Arrived" status up before it clears.
POST_ARRIVAL_BUFFER_MINUTES=15
# Scheduler-only: how often to run the check, in seconds.
POLL_INTERVAL_SECONDS=300

# --- Vercel deploy only ---
# Set this in Vercel (not needed locally). Vercel Cron sends it as a bearer
# token; the /api/cron function rejects requests without it.
CRON_SECRET=
